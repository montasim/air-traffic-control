{
  "name": "air-traffic-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "description": "A browser air traffic control game with nine airfields, three difficulty levels, and local career progression.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/air-traffic-control.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/air-traffic-control/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.13.0"
}
