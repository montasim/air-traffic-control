{
  "name": "air-traffic-control",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/ -- npx --yes netlify-cli@23.11.1 dev --offline",
    "dev:vite": "vite --host 0.0.0.0 --port 3999 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "infisical run --env=dev --path=/ -- drizzle-kit migrate",
    "db:migrate:prod": "infisical run --env=prod --path=/ -- drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "infisical run --env=dev --path=/ -- drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p netlify/tsconfig.json",
    "build:desktop": "tsc --noEmit && vite build --mode desktop --outDir dist-desktop",
    "desktop": "npm run build:desktop && electron .",
    "package:linux": "npm run build:desktop && electron-builder --linux AppImage --x64 --publish never",
    "package:snap": "npm run build:desktop && node scripts/package-snap.mjs",
    "package:msix": "npm run build:desktop && node scripts/package-msix.mjs",
    "build:android": "tsc --noEmit && vite build --mode android --outDir dist-android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "package:android": "npm run android:sync && node scripts/package-android.mjs",
    "icons:windows": "node scripts/generate-windows-icons.mjs",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "package:dir": "npm run build:desktop && electron-builder --linux --x64 --dir --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:resize": "node scripts/test-resize.mjs",
    "test:resize:maps": "node scripts/test-resize-maps.mjs",
    "test:runway-mode": "node scripts/test-runway-mode.mjs",
    "test:runway-ends": "node scripts/test-runway-ends.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/splash-screen": "8.0.2",
    "@hugeicons/core-free-icons": "4.3.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@netlify/database-dev": "^1.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "description": "A browser air traffic control game with nine airfields, three difficulty levels, and local career progression.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/air-traffic-control.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/air-traffic-control/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.13.0",
  "homepage": "https://airtrafficcontrol.netlify.app/",
  "main": "electron/main.cjs",
  "productName": "Air Traffic Control",
  "author": {
    "name": "Montasim",
    "url": "https://github.com/montasim"
  },
  "desktopName": "air-traffic-control"
}
